# Type de spectacle en francais, d'apres la classification Ticketmaster
GENRES_MUSIQUE = {
    "Chanson Francaise": u"chanson", "Rock": u"rock", "Pop": u"pop", "Metal": u"métal",
    "Hip-Hop/Rap": u"rap", "Dance/Electronic": u"électro", "World": u"musiques du monde",
    "R&B": u"R&B", "Jazz": u"jazz", "Blues": u"blues", "Reggae": u"reggae",
    "Religious": u"gospel", "Classical": u"classique", "Country": u"country", "Folk": u"folk",
}
GENRES_SPECTACLE = {
    "Comedy": u"Humour", "Circus & Specialty Acts": u"Cirque", "Children's Theatre": u"Jeune public",
    "Magic & Illusion": u"Magie", "Opera": u"Opéra", "Classical": u"Concert classique",
}
SOUS_GENRES_SPECTACLE = {
    "Musical": u"Comédie musicale", "Monologue": u"Seul en scène", "Ballet": u"Ballet",
}


def type_spectacle(evenement):
    c = (evenement.get("classifications") or [{}])[0]
    segment = (c.get("segment") or {}).get("name")
    genre = (c.get("genre") or {}).get("name")
    sous_genre = (c.get("subGenre") or {}).get("name")
    if segment == "Music":
        precision = GENRES_MUSIQUE.get(genre)
        return u"Concert " + precision if precision else u"Concert"
    if sous_genre in SOUS_GENRES_SPECTACLE:
        return SOUS_GENRES_SPECTACLE[sous_genre]
    if genre in GENRES_SPECTACLE:
        return GENRES_SPECTACLE[genre]
    if genre == "Theatre":
        return u"Théâtre"
    if genre == "Dance":
        return u"Danse"
    return u"Spectacle"


def normaliser(texte):
    """Minuscules sans accents ni ponctuation, pour comparer des textes"""
    t = unicodedata.normalize("NFKD", texte or u"")
    t = u"".join(ch for ch in t if not unicodedata.combining(ch)).lower()
    return u" ".join(re.findall(r"\w+", t, flags=re.U))


def nettoyer_titre(titre, salle, ville):
    """Retire du titre les morceaux repetes, la ville et le nom de la salle.
    "CIRQUE DU SOLEIL - OVO - OVO - STRASBOURG - ZENITH DE STRASBOURG"
    devient "CIRQUE DU SOLEIL - OVO"."""
    lieu = set(normaliser(salle + u" " + ville).split())
    gardes = []
    for morceau in re.split(r"\s+-\s+", u" ".join(titre.split())):
        n = normaliser(morceau)
        if not n:
            continue
        if gardes:
            mots = [m for m in n.split() if len(m) > 2]
            if mots and all(m in lieu for m in mots):
                continue                      # ville ou salle
            if any(n in normaliser(g) for g in gardes):
                continue                      # deja dit
            plus_court = [g for g in gardes if normaliser(g) in n]
            if plus_court:                    # version plus complete d'un morceau deja garde
                gardes = [g for g in gardes if g not in plus_court]
        gardes.append(morceau)
    return u" - ".join(gardes).upper()


def lire_config():
    try:
        with open("config.json") as f:
            return json.load(f)
    except Exception:
        return {}


def codes_postaux(texte):
    """ "67, 68" -> departements entiers ; "67000, 67100" -> codes postaux precis.
    Chaque code garde les salles dont le code postal commence par lui."""
    return re.findall(r"\d{2,5}", texte or "")


def geohash(lat, lon, longueur=7):
    base32 = "0123456789bcdefghjkmnpqrstuvwxyz"
    plage_lat, plage_lon = [-90.0, 90.0], [-180.0, 180.0]
    resultat, bit, car, pair = "", 0, 0, True
    while len(resultat) < longueur:
        plage, valeur = (plage_lon, lon) if pair else (plage_lat, lat)
        milieu = (plage[0] + plage[1]) / 2
        if valeur > milieu:
            car |= 1 << (4 - bit)
            plage[0] = milieu
        else:
            plage[1] = milieu
        pair = not pair
        bit += 1
        if bit == 5:
            resultat += base32[car]
            bit, car = 0, 0
    return resultat


def interroger(cle, dep, jours):
    lat, lon, rayon = CENTRES[dep]
    maintenant = datetime.datetime.utcnow().replace(microsecond=0)
    fin = maintenant + datetime.timedelta(days=jours)
    evenements = []
    page = 0
    while True:
        params = {
            "apikey": cle,
            "geoPoint": geohash(lat, lon),
            "radius": rayon,
            "unit": "km",
            "segmentId": SEGMENTS,
            "startDateTime": maintenant.isoformat() + "Z",
            "endDateTime": fin.isoformat() + "Z",
            "sort": "date,asc",
            "size": 200,
            "page": page,
            "locale": "*",
        }
        if len(dep) == 2:
            # Metropole : evite les salles allemandes ou suisses aux codes postaux proches
            params["countryCode"] = "FR"
        r = requests.get(URL, timeout=30, params=params)
        r.raise_for_status()
        donnees = r.json()
        evenements += donnees.get("_embedded", {}).get("events", [])
        page += 1
        total_pages = donnees.get("page", {}).get("totalPages", 0)
        if page >= total_pages or (page + 1) * 200 > 1000:   # limite de l'API
            return evenements
        time.sleep(0.5)


def affiche_url(images):
    """Image 3:2 la plus proche de 640 px de large"""
    candidates = [i for i in images or [] if i.get("ratio") == "3_2"] or list(images or [])
    if not candidates:
        return None
    return min(candidates, key=lambda i: abs((i.get("width") or 0) - 640)).get("url")


def date_courte(jour):
    return "%s %02d/%02d" % (JOURS[jour.weekday()], jour.day, jour.month)


def resumer(evenements, codes):
    """Un element par spectacle et par salle, avec sa prochaine date"""
    spectacles = {}
    vus = set()
    for e in evenements:
        if e.get("id") in vus:
            continue
        vus.add(e.get("id"))
        salle = (e.get("_embedded", {}).get("venues") or [{}])[0]
        cp = salle.get("postalCode") or ""
        if not any(cp.startswith(c) for c in codes):
            continue
        if e.get("dates", {}).get("status", {}).get("code") in STATUTS_EXCLUS:
            continue
        debut = e.get("dates", {}).get("start", {})
        if not debut.get("localDate"):
            continue
        jour = datetime.datetime.strptime(debut["localDate"], "%Y-%m-%d")
        heure = (debut.get("localTime") or "")[:5]

        cle = (e.get("name", "").strip().lower(), salle.get("id"))
        s = spectacles.get(cle)
        if s is None:
            nom_salle = u" ".join((salle.get("name") or u"").split())
            ville = re.sub(r"\s+cedex.*$", u"", (salle.get("city") or {}).get("name") or u"", flags=re.I)
            spectacles[cle] = {
                "id": e.get("id"),
                "titre": nettoyer_titre(e.get("name", u""), nom_salle, ville),
                "type": type_spectacle(e),
                "salle": nom_salle,
                "ville": ville,
                "debut": jour, "heure": heure, "fin": jour,
                "image": affiche_url(e.get("images")),
            }
        else:
            if (jour, heure) < (s["debut"], s["heure"]):
                s["debut"], s["heure"] = jour, heure
            s["fin"] = max(s["fin"], jour)

    resultat = []
    for s in sorted(spectacles.values(), key=lambda s: (s["debut"], s["heure"], s["titre"])):
        resultat.append({
            "id": s["id"],
            "titre": s["titre"],
            "type": s["type"],
            "salle": s["salle"],
            "ville": s["ville"],
            "jour": date_courte(s["debut"]),
            "heure": s["heure"].replace(":", "h") if s["heure"] else "",
            "fin": "%02d/%02d" % (s["fin"].day, s["fin"].month) if s["fin"] > s["debut"] else None,
            "image": s["image"],
        })
    return resultat


def nom_affiche(evenement):
    return "affiche-%s.jpg" % re.sub(r"[^A-Za-z0-9_-]", "", evenement["id"])


def telecharger_affiches(liste):
    """Telecharge les affiches manquantes et supprime celles qui ne servent plus"""
    utiles = set()
    for e in liste:
        url = e.pop("image")
        if not url:
            e["affiche"] = None
            continue
        nom = nom_affiche(e)
        utiles.add(nom)
        e["affiche"] = nom
        if os.path.exists(nom):
            continue
        try:
            r = requests.get(url, timeout=30)
            r.raise_for_status()
            with open(nom + ".tmp", "wb") as f:
                f.write(r.content)
            os.rename(nom + ".tmp", nom)
        except Exception:
            traceback.print_exc()
            e["affiche"] = None
    for nom in os.listdir("."):
        if nom.startswith("affiche-") and nom not in utiles:
            os.remove(nom)


def ecrire(liste):
    with open("agenda.json.tmp", "w") as f:
        json.dump({"maj": int(time.time()), "evenements": liste}, f)
    os.rename("agenda.json.tmp", "agenda.json")


def departements(code):
    """Departement(s) a interroger pour un code postal ou un debut de code"""
    if code.startswith("97"):
        return [code[:3]] if len(code) >= 3 else [d for d in CENTRES if d.startswith("97")]
    if code.startswith("20"):
        return ["2A", "2B"]                  # Corse : codes postaux 20...
    return [code[:2]]


def collecter(cle, codes, jours=JOURS_A_VENIR):
    evenements = []
    deps = sorted(set(d for c in codes for d in departements(c)))
    for dep in deps:                         # une recherche par departement
        if dep in CENTRES:
            evenements += interroger(cle, dep, jours)
            time.sleep(0.5)
        else:
            print("departement %s inconnu, ignore" % dep)
    return resumer(evenements, codes)


def nombre_jours(config):
    try:
        return min(max(int(config.get("jours") or JOURS_A_VENIR), 1), 365)
    except (TypeError, ValueError):
        return JOURS_A_VENIR


def attendre(secondes):
    """Attend, mais repart tout de suite si les reglages changent"""
    def date_config():
        try:
            return os.path.getmtime("config.json")
        except OSError:
            return None
    avant = date_config()
    fin = time.time() + secondes
    while time.time() < fin:
        time.sleep(10)
        if date_config() != avant:
            return


def main():
    while True:
        config = lire_config()
        cle = (config.get("cle_api") or "").strip()
        codes = codes_postaux(config.get("codes_postaux"))
        if not cle or not codes:
            print("agenda: cle API ou codes postaux manquants")
            attendre(60)
            continue
        try:
            liste = collecter(cle, codes, nombre_jours(config))
            telecharger_affiches(liste)
            ecrire(liste)
            print("agenda: %d spectacles" % len(liste))
            attendre(PERIODE)
        except Exception:
            traceback.print_exc()
            attendre(PERIODE_ERREUR)


if __name__ == "__main__":
    main()
